# Copiá este archivo a `.env` y completá las keys.
#
#   cp .env.example .env
#
# `.env` está en .gitignore a propósito: las credenciales no se commitean. El
# costo es que al clonar el repo en otra máquina NADA de esto viaja — incluido
# LLM_PROVIDER. Si no existe `.env`, config.py cae al default `groq`.

# ── Proveedor del chat ───────────────────────────────────────────────────────
# groq | gemini | cerebras | openai
LLM_PROVIDER=gemini

# Solo hace falta la key del proveedor que esté activo arriba.
GEMINI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# Respaldo gratis (plan Experiment, https://console.mistral.ai/api-keys):
# entra cuando el proveedor principal falla.
# MISTRAL_API_KEY=
# OPENAI_API_KEY=

# ── Transcripción de audio ───────────────────────────────────────────────────
# OJO: es independiente del proveedor de chat. Whisper (sesiones en vivo y
# resumen de videos sin subtítulos) SIEMPRE habla con Groq directo, porque
# Gemini/OpenAI no exponen ese mismo endpoint — ver el comentario en config.py.
# Sin esta key el chat funciona igual, pero la transcripción no.
GROQ_API_KEY=

# ── Servidor ─────────────────────────────────────────────────────────────────
# PORT=8732
